---
import { bookingUrl } from "../../utils/api";
import { SITE, NAV, waLink } from "../../data/siteConfig";
import { KATEGORI } from "../../data/services";
import Icon from "../ui/Icon.astro";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const socials = [
  { label: "Instagram", href: SITE.social.instagram, icon: "M12 2.2c3.2 0 3.6 0 4.9.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.9.1-3.2 0-3.6 0-4.8-.1-3.3-.1-4.8-1.7-4.9-4.9-.1-1.3-.1-1.6-.1-4.8s0-3.6.1-4.8C2.4 4 4 2.4 7.2 2.3c1.2-.1 1.6-.1 4.8-.1zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm5.2-9.4a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z" },
  { label: "Facebook", href: SITE.social.facebook, icon: "M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2.1-.1-2.1 0-3.6 1.3-3.6 3.7V11H8.3v3h2.4v7h2.8z" },
  { label: "YouTube", href: SITE.social.youtube, icon: "M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15.2V8.8L15.5 12 10 15.2z" },
];
---
<!-- Topbar -->
<div class="hidden bg-primary-deep text-white/90 md:block">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-1.5 text-xs">
    <div class="flex items-center gap-4">
      <span class="inline-flex items-center gap-1.5">
        <svg class="size-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
        <a href="tel:${SITE.phone.replace(/-/g, '')}" class="hover:text-white">{SITE.phone}</a>
      </span>
      <span class="text-white/40">·</span>
      <span>{SITE.hours}</span>
    </div>
    <div class="flex items-center gap-3">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="opacity-80 transition hover:opacity-100 hover:text-primary-light">
          <svg class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d={s.icon} /></svg>
        </a>
      ))}
    </div>
  </div>
</div>

<!-- Header -->
<header id="site-header" class="sticky top-0 z-50 border-b border-line/70 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label="Beranda B Fresh Dental Care">
      <img src="/images/logos/logo.png" alt="Logo B Fresh Dental Care" width="200" height="75" class="h-12 w-auto md:h-14" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigasi utama">
      {NAV.filter((n) => "children" in n && n.children === "services").map((n) => (
        <div class="group relative">
          <a href={n.href} class={`inline-flex items-center gap-1 rounded-full px-3.5 py-2 text-sm font-semibold transition ${isActive(n.href) ? "text-primary" : "text-ink-soft hover:bg-primary-soft hover:text-primary"}`}>
            {n.label}
            <svg class="size-3.5 transition group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
          </a>
          <div class="invisible absolute left-1/2 top-full z-50 w-80 -translate-x-1/2 pt-2 opacity-0 transition-all group-hover:visible group-hover:opacity-100">
            <div class="overflow-hidden rounded-2xl border border-line bg-white p-2 shadow-card-hover">
              {KATEGORI.map((k) => (
                <a href={`/layanan#${k.slug}`} class="flex items-start gap-3 rounded-xl px-3 py-2.5 transition hover:bg-primary-soft">
                  <Icon name={k.icon} class="size-5 text-primary" />
                  <span>
                    <span class="block text-sm font-bold text-primary-deep">{k.label}</span>
                    <span class="block text-xs text-ink-soft">{k.tagline}</span>
                  </span>
                </a>
              ))}
              <a href="/layanan" class="block rounded-xl px-3 py-2 text-center text-xs font-bold text-primary transition hover:bg-primary-soft">Lihat semua layanan →</a>
            </div>
          </div>
        </div>
      ))}
      {NAV.filter((n) => !("children" in n)).map((n) => (
        <a href={n.href} class={`rounded-full px-3.5 py-2 text-sm font-semibold transition ${isActive(n.href) ? "text-primary" : "text-ink-soft hover:bg-primary-soft hover:text-primary"}`}>
          {n.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={waLink()} target="_blank" rel="noopener" class="hidden items-center gap-2 rounded-full border-2 border-secondary/30 px-4 py-2 text-sm font-bold text-secondary transition hover:border-secondary hover:bg-secondary-soft md:inline-flex">
        <svg class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.5 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.3.7-.2.3.1 1.6.8 1.9.9.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
        WhatsApp
      </a>
      <a href={bookingUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-accent-dark hover:shadow-md">
        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
        Reservasi
      </a>
      <button id="menu-toggle" class="rounded-lg p-2 text-ink-soft transition hover:bg-primary-soft lg:hidden" aria-label="Buka menu" aria-expanded="false">
        <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-menu" class="hidden border-t border-line bg-white lg:hidden">
    <nav class="mx-auto max-w-7xl px-4 py-3" aria-label="Navigasi mobile">
      {NAV.filter((n) => !("children" in n)).map((n) => (
        <a href={n.href} class={`block rounded-xl px-4 py-3 text-sm font-semibold ${isActive(n.href) ? "bg-primary-soft text-primary" : "text-ink hover:bg-bg"}`}>{n.label}</a>
      ))}
      <details class="rounded-xl">
        <summary class="cursor-pointer list-none px-4 py-3 text-sm font-semibold text-ink">Layanan</summary>
        <div class="pb-2 pl-6">
          {KATEGORI.map((k) => (
            <a href={`/layanan#${k.slug}`} class="block rounded-lg px-4 py-2 text-sm text-ink-soft hover:text-primary"><Icon name={k.icon} class="size-4" /> {k.label}</a>
          ))}
        </div>
      </details>
      <div class="mt-2 grid grid-cols-2 gap-2 p-2">
        <a href={waLink()} target="_blank" rel="noopener" class="rounded-full border-2 border-secondary/40 py-2.5 text-center text-sm font-bold text-secondary">WhatsApp</a>
        <a href={bookingUrl} target="_blank" rel="noopener" class="rounded-full bg-accent py-2.5 text-center text-sm font-bold text-white">Reservasi</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
