---
import { getCollection } from "astro:content";
import { SITE } from "../../data/siteConfig";
import SectionHeading from "../ui/SectionHeading.astro";
import PostThumb from "../cards/PostThumb.astro";
import { tanggalID } from "../../utils/format";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);
---

<section id="edukasi" class="bg-white py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4">
    <SectionHeading
      eyebrow="Edukasi Gigi"
      title="Belajar Rawat Senyum, Gratis"
      sub="Artikel edukasi ditinjau tim medis kami — jawaban jujur untuk pertanyaan yang paling sering ditanyakan pasien."
    >
      <a href="/informasi" slot="cta" class="inline-flex items-center gap-2 rounded-full border-2 border-primary/25 bg-white px-6 py-3 text-sm font-bold text-primary transition hover:border-primary hover:bg-primary-soft">
        Semua artikel
        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </SectionHeading>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        posts.map((p) => (
          <a href={`/informasi/${p.data.slug}`} class="reveal group flex flex-col overflow-hidden rounded-card border border-line bg-white shadow-card transition duration-200 hover:-translate-y-1 hover:shadow-card-hover">
            <div class="relative aspect-[16/10] overflow-hidden bg-primary-soft">
              <PostThumb image={p.data.image} alt={p.data.title} category={p.data.category} />
              <span class="absolute top-3 left-3 rounded-full bg-white/90 px-3 py-1 text-[10px] font-bold tracking-wider text-primary uppercase backdrop-blur">
                {p.data.category}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <p class="text-xs font-semibold text-ink-soft">{tanggalID(p.data.date)}</p>
              <h3 class="mt-1.5 font-heading text-base leading-snug font-bold text-primary-deep transition group-hover:text-primary">{p.data.title}</h3>
              <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-ink-soft">{p.data.excerpt}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-xs font-bold text-accent transition group-hover:gap-2">
                Baca selengkapnya
                <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
