---
/**
 * Peta interaktif semua cabang — Leaflet + OpenStreetMap (tanpa API key).
 * Pin custom brand; popup: nama + alamat + link detail & jadwal dokter.
 */
import "leaflet/dist/leaflet.css";
import branches from "../../data/branches.json";
import type { Branch } from "../../data/types";

const pts = (branches as Branch[]).filter((b) => b.lat != null && b.lng != null);
const DATA = JSON.stringify(pts.map((b) => ({ n: b.name, c: b.cityLabel, a: b.address, s: b.slug, lat: b.lat!, lng: b.lng! })));
---

<section class="bg-white py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-4">
    <div class="reveal flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="font-heading text-2xl font-extrabold text-primary-deep">Peta {pts.length} Cabang Kami</h2>
        <p class="mt-1 text-sm text-ink-soft">Klik pin untuk alamat &amp; detail cabang — geser/zoom peta sesuai kebutuhan.</p>
      </div>
      <a
        href="https://www.google.com/maps/search/?api=1&query=B+Fresh+Dental+Care"
        target="_blank" rel="noopener"
        class="inline-flex items-center gap-1.5 rounded-full border-2 border-primary/20 bg-white px-4 py-2 text-xs font-bold text-primary transition hover:border-primary"
      >
        Buka di Google Maps
        <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
    </div>

    <div class="reveal mt-6 overflow-hidden rounded-card border border-line shadow-card">
      <div
        id="branch-map"
        class="h-[26rem] w-full md:h-[30rem]"
        role="application"
        aria-label="Peta lokasi semua cabang B Fresh Dental Care"
        data-pts={DATA}
      ></div>
    </div>
    <noscript>
      <p class="mt-3 text-xs text-ink-soft">Peta memerlukan JavaScript — daftar lengkap cabang tetap tersedia di bawah.</p>
    </noscript>
  </div>
</section>

<script>
  import L from "leaflet";

  const el = document.getElementById("branch-map");
  const pts = JSON.parse(el?.dataset.pts ?? "[]") as {
    n: string; c: string; a: string; s: string; lat: number; lng: number;
  }[];

  if (el && pts.length) {
    const map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    // pin custom brand (sekaligus hindari ikon default Leaflet yg rusak saat bundling)
    const pin = L.divIcon({
      className: "",
      html: `<span style="display:flex;width:26px;height:26px;border-radius:50% 50% 50% 0;background:#0E6AB3;border:3px solid #fff;box-shadow:0 3px 10px rgb(8 63 107/.45);transform:rotate(-45deg);align-items:center;justify-content:center"><span style="transform:rotate(45deg);font-size:12px">🦷</span></span>`,
      iconSize: [26, 26],
      iconAnchor: [13, 26],
      popupAnchor: [0, -26],
    });

    const markers = pts.map((p) =>
      L.marker([p.lat, p.lng], { icon: pin, title: `B Fresh ${p.n}` })
        .addTo(map)
        .bindPopup(
          `<div style="min-width:200px;font-family:system-ui">
            <strong style="color:#083f6b">B Fresh ${p.n}</strong> <span style="color:#61A74D;font-size:11px;font-weight:700">· ${p.c}</span><br/>
            <span style="font-size:12px;color:#4b5563">${p.a}</span><br/>
            <a href="/cabang/${p.s}" style="display:inline-block;margin-top:6px;font-size:12px;font-weight:700;color:#F2994A">Detail cabang &amp; jadwal dokter →</a>
          </div>`,
        ),
    );

    map.fitBounds(L.featureGroup(markers).getBounds().pad(0.18));
  }
</script>
