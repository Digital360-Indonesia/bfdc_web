---
/**
 * Filter kota bersama (dipakai BranchLocator homepage & halaman /cabang):
 * pills tombol + wrapper grid + empty-state + pre-select dari ?kota=…
 */
import branches from "../../data/branches.json";

const cities = [...new Set(branches.map((b) => b.cityLabel))];
---
<div data-locator>
  <div class="reveal flex flex-wrap justify-center gap-2" data-locator-pills role="group" aria-label="Filter kota">
    <button
      type="button"
      data-city=""
      class="cursor-pointer rounded-full border-2 border-primary bg-primary-soft px-4 py-2 text-sm font-bold text-primary transition hover:border-primary"
    >
      Semua Kota
    </button>
    {
      cities.map((c) => (
        <button
          type="button"
          data-city={c}
          class="cursor-pointer rounded-full border-2 border-line bg-white px-4 py-2 text-sm font-semibold text-ink-soft transition hover:border-primary/40 hover:text-primary"
        >
          {c}
        </button>
      ))
    }
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-locator-grid>
    <slot />
  </div>
  <p class="mt-6 hidden text-center text-sm text-ink-soft" data-locator-empty>
    Tidak ada cabang yang cocok dengan pencarian Anda.
  </p>
</div>

<script>
  const root = document.querySelector("[data-locator]");
  const pills = root?.querySelectorAll<HTMLButtonElement>("[data-city]");
  const cards = root?.querySelectorAll<HTMLElement>("[data-city-card]");
  const empty = root?.querySelector<HTMLElement>("[data-locator-empty]");

  const setActive = (btn: HTMLButtonElement) => {
    pills?.forEach((p) => {
      const on = p === btn;
      p.className = on
        ? "cursor-pointer rounded-full border-2 border-primary bg-primary-soft px-4 py-2 text-sm font-bold text-primary transition hover:border-primary"
        : "cursor-pointer rounded-full border-2 border-line bg-white px-4 py-2 text-sm font-semibold text-ink-soft transition hover:border-primary/40 hover:text-primary";
    });
  };

  pills?.forEach((btn) =>
    btn.addEventListener("click", () => {
      setActive(btn);
      const city = btn.dataset.city ?? "";
      let visible = 0;
      cards?.forEach((card) => {
        const match = !city || card.dataset.cityCard === city;
        card.classList.toggle("hidden", !match);
        if (match) visible++;
      });
      if (empty) empty.classList.toggle("hidden", visible > 0);
    }),
  );

  // pre-select dari ?kota= (deep-link, mis. footer "Klinik Gigi Surabaya")
  const param = new URLSearchParams(location.search).get("kota");
  if (param) {
    const target = [...(pills ?? [])].find((p) =>
      (p.dataset.city ?? "").toLowerCase() === param.toLowerCase(),
    );
    target?.click();
    target?.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }
</script>
