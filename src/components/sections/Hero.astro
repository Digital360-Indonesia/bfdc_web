---
import { SITE, STATS, waLink } from "../../data/siteConfig";
import Button from "../ui/Button.astro";
---

<section class="relative overflow-hidden bg-gradient-to-b from-primary-soft via-bg to-white">
  <!-- dekor lembut -->
  <div class="pointer-events-none absolute -top-24 -right-24 size-96 rounded-full bg-primary-light/25 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-32 -left-16 size-80 rounded-full bg-secondary/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 pt-12 pb-14 md:pt-16 lg:grid-cols-2 lg:gap-14 lg:pt-20">
    <div class="reveal">
      <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-secondary/25 bg-secondary-soft px-4 py-1.5 text-xs font-bold text-secondary-dark">
        <svg class="size-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17l-6.1 3.6 1.4-6.8L2.2 9.1l6.9-.8z"/></svg>
        Terpercaya sejak {SITE.since} · {STATS.find((s) => s.label.includes("cabang"))?.value} Cabang · 5 Kota
      </span>

      <h1 class="text-balance font-heading text-4xl leading-[1.12] font-extrabold text-primary-deep sm:text-5xl lg:text-[3.4rem]">
        Senyum Sehat &amp; Percaya Diri untuk
        <span class="relative whitespace-nowrap text-primary">
          Seluruh Keluarga
          <svg class="absolute -bottom-2 left-0 w-full text-accent" viewBox="0 0 220 10" fill="none" aria-hidden="true" preserveAspectRatio="none">
            <path d="M2 8c40-5 120-7 216-3" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
          </svg>
        </span>
      </h1>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-soft md:text-lg">
        Klinik dokter gigi kekeluargaan dengan {STATS.find((s) => s.label === "Dokter Gigi")?.value} dokter gigi dan
        {STATS.find((s) => s.label === "Dokter Spesialis")?.value} dokter spesialis — dari scaling rutin
        hingga behel &amp; gigi tiruan. Harga transparan, reservasi mudah.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={SITE.bookingUrl} target="_blank" rel="noopener" variant="accent" size="lg">
          <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
          Reservasi Sekarang
        </Button>
        <Button href={waLink()} target="_blank" rel="noopener" variant="outline" size="lg">
          <svg class="size-5 text-secondary" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.5 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.3.7-.2.3.1 1.6.8 1.9.9.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
          Tanya via WhatsApp
        </Button>
      </div>

      <dl class="mt-9 grid max-w-lg grid-cols-3 gap-4 border-t border-line pt-6">
        <div>
          <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Pasien</dt>
          <dd class="font-heading text-xl font-extrabold text-primary">57rb+</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Kepuasan</dt>
          <dd class="font-heading text-xl font-extrabold text-secondary">95%</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Spesialis</dt>
          <dd class="font-heading text-xl font-extrabold text-primary">9 Dokter</dd>
        </div>
      </dl>
    </div>

    <div class="reveal relative">
      <div class="relative mx-auto max-w-md lg:max-w-none">
        <img
          src="/images/hero-dental.webp"
          alt="Suasana perawatan gigi yang nyaman di B Fresh Dental Care"
          width="880" height="660" loading="eager" decoding="async"
          class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-card-hover"
        />
        <!-- kartu mengambang -->
        <div class="absolute -bottom-5 left-4 flex items-center gap-3 rounded-2xl border border-line bg-white/95 p-3.5 pr-5 shadow-card backdrop-blur md:-left-6">
          <span class="flex size-11 items-center justify-center rounded-full bg-secondary-soft text-secondary">
            <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <div>
            <p class="text-sm font-bold text-primary-deep">Harga Transparan</p>
            <p class="text-xs text-ink-soft">Scaling mulai Rp 150rb</p>
          </div>
        </div>
        <div class="absolute -top-4 right-4 flex items-center gap-3 rounded-2xl border border-line bg-white/95 p-3 pr-5 shadow-card backdrop-blur md:right-0">
          <span class="flex size-11 items-center justify-center rounded-full bg-primary-soft text-primary">
            <svg class="size-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21s-8-4.35-8-10a4.62 4.62 0 0 1 8-3.15A4.62 4.62 0 0 1 20 11c0 5.65-8 10-8 10z"/></svg>
          </span>
          <div>
            <p class="text-sm font-bold text-primary-deep">Bebas Rasa Takut</p>
            <p class="text-xs text-ink-soft">Dokter ramah &amp; edukatif</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
