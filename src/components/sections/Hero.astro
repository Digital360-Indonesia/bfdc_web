---
import { SITE, STATS, waLink } from "../../data/siteConfig";
import Button from "../ui/Button.astro";
---

<section class="relative flex flex-1 flex-col justify-center overflow-hidden bg-gradient-to-b from-primary-soft via-bg to-white">
  <!-- dekorasi lembut, tanpa foto -->
  <div class="pointer-events-none absolute -top-28 -right-24 size-[26rem] rounded-full bg-primary-light/25 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-36 -left-20 size-96 rounded-full bg-secondary/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute top-16 left-[8%] hidden opacity-25 lg:block" aria-hidden="true">
    <svg class="size-16 text-primary-light" viewBox="0 0 64 64" fill="currentColor"><path d="M32 4C22 4 14 12.4 14 24c0 8 2.6 12.8 4.4 17.4 1.4 3.6 2.2 10 4.6 14.2 1.4 2.6 4.8 2.8 6.4.3 1.6-2.4-.3-7.4 2.6-7.4 2.9 0 1 5 2.6 7.4 1.6 2.5 5 2.3 6.4-.3 2.4-4.2 3.2-10.6 4.6-14.2C47.4 36.8 50 32 50 24 50 12.4 42 4 32 4zm-9 22a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm18 0a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" opacity=".55"/></svg>
  </div>
  <div class="pointer-events-none absolute right-[12%] bottom-10 hidden opacity-20 lg:block" aria-hidden="true">
    <svg class="size-12 text-secondary" viewBox="0 0 64 64" fill="currentColor"><path d="M32 4C22 4 14 12.4 14 24c0 8 2.6 12.8 4.4 17.4 1.4 3.6 2.2 10 4.6 14.2 1.4 2.6 4.8 2.8 6.4.3 1.6-2.4-.3-7.4 2.6-7.4 2.9 0 1 5 2.6 7.4 1.6 2.5 5 2.3 6.4-.3 2.4-4.2 3.2-10.6 4.6-14.2C47.4 36.8 50 32 50 24 50 12.4 42 4 32 4z" opacity=".5"/></svg>
  </div>

  <div class="relative mx-auto w-full max-w-4xl px-4 py-14 text-center md:py-20">
    <span class="reveal mb-5 inline-flex items-center gap-2 rounded-full border border-secondary/25 bg-white/70 px-4 py-1.5 text-xs font-bold text-secondary-dark shadow-card backdrop-blur">
      <svg class="size-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17l-6.1 3.6 1.4-6.8L2.2 9.1l6.9-.8z"/></svg>
      Terpercaya sejak {SITE.since} · {STATS.find((s) => s.label.includes("cabang"))?.value} Cabang · 5 Kota Jawa Timur
    </span>

    <h1 class="reveal text-balance mx-auto font-heading text-4xl leading-[1.1] font-extrabold text-primary-deep sm:text-5xl lg:text-6xl" style="animation-delay:.08s">
      Senyum Sehat &amp; Percaya Diri
      <span class="mt-1 block text-primary">untuk Seluruh Keluarga</span>
    </h1>

    <p class="reveal mx-auto mt-6 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg" style="animation-delay:.16s">
      Klinik dokter gigi kekeluargaan dengan <strong class="font-semibold text-ink">80+ dokter gigi</strong> berpengalaman —
      dari scaling rutin hingga behel &amp; gigi tiruan, termasuk perawatan oleh dokter spesialis.
      Harga transparan, reservasi mudah tanpa antre.
    </p>

    <div class="reveal mt-9 flex flex-col justify-center gap-3 sm:flex-row" style="animation-delay:.24s">
      <Button href={SITE.bookingUrl} target="_blank" rel="noopener" variant="accent" size="lg">
        <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
        Reservasi Sekarang
      </Button>
      <Button href={waLink()} target="_blank" rel="noopener" variant="outline" size="lg">
        <svg class="size-5 text-secondary" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.5 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.3.7-.2.3.1 1.6.8 1.9.9.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
        Tanya via WhatsApp
      </Button>
    </div>

    <dl class="reveal mx-auto mt-12 grid max-w-2xl grid-cols-3 gap-3 sm:gap-6" style="animation-delay:.32s">
      <div class="rounded-2xl border border-line/70 bg-white/70 px-2 py-4 shadow-card backdrop-blur">
        <dt class="text-[11px] font-semibold tracking-wide text-ink-soft uppercase">Pasien Dilayani</dt>
        <dd class="mt-1 font-heading text-xl font-extrabold text-primary md:text-2xl">100rb+</dd>
      </div>
      <div class="rounded-2xl border border-line/70 bg-white/70 px-2 py-4 shadow-card backdrop-blur">
        <dt class="text-[11px] font-semibold tracking-wide text-ink-soft uppercase">Kepuasan Pasien</dt>
        <dd class="mt-1 font-heading text-xl font-extrabold text-secondary md:text-2xl">95%</dd>
      </div>
      <div class="rounded-2xl border border-line/70 bg-white/70 px-2 py-4 shadow-card backdrop-blur">
        <dt class="text-[11px] font-semibold tracking-wide text-ink-soft uppercase">Jenis Perawatan</dt>
        <dd class="mt-1 font-heading text-xl font-extrabold text-primary md:text-2xl">50+</dd>
      </div>
    </dl>
  </div>
</section>
