---
/**
 * Promo LIVE dari API publik bfdc_app (tabel promos bfdc_marketing —
 * dikelola tim marketing). Grid statis hasil build tetap dirender sebagai
 * baseline SEO/no-JS; island menggantinya saat fetch sukses sehingga promo
 * kedaluwarsa tidak pernah tampil basi.
 */
import promosJson from "../../data/promos.json";
import { SITE } from "../../data/siteConfig";
import { publicApi } from "../../utils/api";
import type { Promo } from "../../data/types";

const promos = promosJson as Promo[];
const API = `${publicApi}/api/public/promo`;
const tanggalID = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-promo-root data-api={API}>
  {
    promos.map((p) => (
      <article class="reveal group flex flex-col overflow-hidden rounded-card border border-line bg-white shadow-card transition duration-200 hover:-translate-y-1 hover:shadow-card-hover">
        {p.img && (
          <div class="relative aspect-[542/286] overflow-hidden bg-primary-soft">
            <img src={`/images/promo/promo-${p.id}.webp`} alt={`Promo ${p.nama}`} width="542" height="286" loading="lazy" decoding="async" class="size-full object-cover transition duration-300 group-hover:scale-[1.03]" />
          </div>
        )}
        <div class="flex flex-1 flex-col p-5">
          <h2 class="font-heading text-base leading-snug font-bold text-primary-deep">{p.nama}</h2>
          {p.harga && <p class="mt-2 font-heading text-xl font-extrabold text-accent">{p.harga}</p>}
          <div class="mt-4 flex-1" />
          <p class="text-xs text-ink-soft">Berlaku s.d. {tanggalID(p.akhir)}</p>
          <a href={SITE.bookingUrl} target="_blank" rel="noopener" class="mt-4 inline-flex items-center justify-center gap-1.5 rounded-full bg-primary px-5 py-2.5 text-xs font-bold text-white transition hover:bg-primary-dark">
            Klaim Promo — Reservasi
          </a>
        </div>
      </article>
    ))
  }
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-promo-root]");
  const api = root?.dataset.api;
  const BOOKING = "https://app.bfreshgigi.com/reservasi";

  type PromoApi = {
    id: number;
    nama: string;
    harga: string | null;
    gambar_url: string | null;
    akhir: string;
    spesial: boolean;
  };

  const sdID = (iso: string) =>
    new Date(iso + "T00:00:00").toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });

  if (root && api) {
    fetch(api)
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((d: { promo: PromoApi[] }) => {
        const items = d.promo ?? [];
        if (!items.length) {
          root.innerHTML = `<p class="col-span-full rounded-card border border-dashed border-line bg-bg p-8 text-center text-sm text-ink-soft">Belum ada promo berjalan saat ini — pantau terus, promo baru hadir tiap bulan! 🎁</p>`;
          return;
        }
        root.innerHTML = items
          .map(
            (p) => `<article class="reveal is-visible group flex flex-col overflow-hidden rounded-card border border-line bg-white shadow-card transition duration-200 hover:-translate-y-1 hover:shadow-card-hover">
              ${
                p.gambar_url
                  ? `<div class="relative aspect-[542/286] overflow-hidden bg-primary-soft">${
                      p.spesial ? `<span class="absolute top-3 left-3 z-10 rounded-full bg-accent px-3 py-1 text-[10px] font-bold tracking-wider text-white uppercase">Spesial</span>` : ""
                    }<img src="${p.gambar_url}" alt="Promo ${p.nama}" width="542" height="286" loading="lazy" decoding="async" class="size-full object-cover transition duration-300 group-hover:scale-[1.03]" /></div>`
                  : ""
              }
              <div class="flex flex-1 flex-col p-5">
                <h2 class="font-heading text-base leading-snug font-bold text-primary-deep">${p.nama}</h2>
                ${p.harga ? `<p class="mt-2 font-heading text-xl font-extrabold text-accent">${p.harga}</p>` : ""}
                <div class="mt-4 flex-1"></div>
                <p class="text-xs text-ink-soft">Berlaku s.d. ${sdID(p.akhir)}</p>
                <a href="${BOOKING}" target="_blank" rel="noopener" class="mt-4 inline-flex items-center justify-center gap-1.5 rounded-full bg-primary px-5 py-2.5 text-xs font-bold text-white transition hover:bg-primary-dark">Klaim Promo — Reservasi</a>
              </div>
            </article>`,
          )
          .join("");
      })
      .catch(() => {
        /* fetch gagal → biarkan grid statis hasil build tetap tampil */
      });
  }
</script>
