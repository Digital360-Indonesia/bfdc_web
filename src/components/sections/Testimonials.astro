---
import testimonials from "../../data/testimonials.json";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section id="testimoni" class="bg-white py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4">
    <SectionHeading
      eyebrow="Kata Pasien Kami"
      title="95% Pasien Puas — Ini Buktinya"
      sub="Testimoni asli dari survei kepuasan pasien di seluruh cabang B Fresh Dental Care."
    />

    <div class="reveal mt-10 snap-strip -mx-4 flex gap-5 overflow-x-auto px-4 pb-4 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0">
      {
        testimonials.slice(0, 6).map((t) => (
          <figure class="flex w-[85%] shrink-0 flex-col rounded-card border border-line bg-bg p-6 shadow-card md:w-auto">
            <div class="mb-3 flex items-center gap-1 text-accent" aria-label={`Rating ${t.rating} dari 5`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class="size-4" fill={i < t.rating ? "currentColor" : "none"} stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17l-6.1 3.6 1.4-6.8L2.2 9.1l6.9-.8z" />
                </svg>
              ))}
            </div>
            <blockquote class="flex-1 text-sm leading-relaxed text-ink">“{t.quote}”</blockquote>
            <figcaption class="mt-4 flex items-center gap-3 border-t border-line pt-4">
              <span class="flex size-10 items-center justify-center rounded-full bg-primary font-heading text-sm font-extrabold text-white">
                {t.name.charAt(0)}
              </span>
              <div>
                <p class="text-sm font-bold text-primary-deep">{t.name}</p>
                <p class="text-xs text-ink-soft">Pasien {t.branch ? `· ${t.branch}` : "B Fresh"}</p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
