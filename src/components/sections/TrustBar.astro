---
import { STATS } from "../../data/siteConfig";
---
<!-- Strip angka kunci (spec §4.2.3) — sumber: audit DB produksi Sep 2026 -->
<section class="relative z-10 bg-primary">
  <div class="mx-auto max-w-7xl px-4 py-8">
    <dl class="grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-6">
      {
        STATS.map((s) => (
          <div class="reveal text-center">
            <dd class="font-heading text-2xl font-extrabold text-white md:text-3xl">
              {s.value}
              {"suffix" in s && s.suffix ? <span class="text-primary-light">{s.suffix}</span> : null}
            </dd>
            <dt class="mt-1 text-[11px] leading-snug font-semibold tracking-wide text-primary-light/90 uppercase md:text-xs">
              {s.label}
            </dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>
