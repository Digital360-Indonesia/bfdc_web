---
/** Tombol dasar — varian: primary | accent | outline | ghost | white */
interface Props {
  href?: string;
  variant?: "primary" | "accent" | "outline" | "ghost" | "white";
  size?: "md" | "lg" | "sm";
  class?: string;
  [key: string]: unknown;
}
const { href, variant = "primary", size = "md", class: cls = "", ...rest } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary cursor-pointer";

const variants = {
  primary: "bg-primary text-white shadow-sm hover:bg-primary-dark hover:shadow-md",
  accent: "bg-accent text-white shadow-sm hover:bg-accent-dark hover:shadow-md",
  outline:
    "border-2 border-primary/25 bg-white text-primary hover:border-primary hover:bg-primary-soft",
  ghost: "text-primary hover:bg-primary-soft",
  white: "bg-white text-primary shadow-sm hover:bg-primary-soft",
};

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-sm md:text-base",
  lg: "px-8 py-4 text-base md:text-lg",
};
---
<a href={href} class={`${base} ${variants[variant]} ${sizes[size]} ${cls}`} {...rest}>
  <slot />
</a>
