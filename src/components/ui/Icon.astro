---
<svg
  viewBox="0 0 24 24"
  fill={filled ? "currentColor" : "none"}
  stroke={filled ? "none" : "currentColor"}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  {...rest}
>
  {d.split(" M").map((seg, i) => <path d={(i === 0 ? seg : "M" + seg).trim()} />)}
</svg>
