---
/** Kepala section seragam: eyebrow + judul + sub + optional CTA slot */
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  align?: "center" | "left";
  class?: string;
}
const { eyebrow, title, sub, align = "center", class: cls = "" } = Astro.props;
---
<div class={`reveal max-w-2xl ${align === "center" ? "mx-auto text-center" : ""} ${cls}`}>
  {
    eyebrow && (
      <span class="mb-3 inline-block rounded-full bg-primary-soft px-4 py-1 text-xs font-bold tracking-widest text-primary uppercase">
        {eyebrow}
      </span>
    )
  }
  <h2 class="text-balance text-3xl font-extrabold text-primary-deep md:text-4xl">{title}</h2>
  {sub && <p class="mt-3 text-base leading-relaxed text-ink-soft md:text-lg">{sub}</p>}
  <div class="mt-5"><slot name="cta" /></div>
</div>
