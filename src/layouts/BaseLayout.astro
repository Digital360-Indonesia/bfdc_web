---
import { SITE, STATS } from "../data/siteConfig";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import StickyBookingBar from "../components/layout/StickyBookingBar.astro";
import BookingGate from "../components/layout/BookingGate.astro";
import { jsonLdOrg } from "../utils/schema";
import "../styles/global.css";
import "@fontsource-variable/plus-jakarta-sans";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** tambahan JSON-LD spesifik halaman */
  jsonLd?: object | object[];
}

const { title, description, image, noindex } = Astro.props;
const fullTitle = title
  ? `${title} | ${SITE.name}`
  : `${SITE.name} — ${SITE.tagline}`;
const desc = description ?? SITE.description;
const ogImage = image ?? "/og-image.jpg";
const extraLd = Astro.props.jsonLd
  ? Array.isArray(Astro.props.jsonLd) ? Astro.props.jsonLd : [Astro.props.jsonLd]
  : [];
const allLd = [jsonLdOrg(), ...extraLd];
---
<!doctype html>
<html lang="id" class="scheme-light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE.url)} />
    <meta name="theme-color" content="#0E6AB3" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(ogImage, SITE.url)} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.url)} />

    {allLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}

    <!-- Google Tag Manager (GA4 G-7761DFFM9W dimuat via container ini — JANGAN tambah snippet gtag.js terpisah, GA4 bisa dobel-hit) -->
    <script is:inline define:vars={{ gtmId: "GTM-M8MTRT5Q" }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", gtmId);
    </script>
    <!-- End Google Tag Manager -->

    <!-- Meta Pixel Code -->
    <meta name="facebook-domain-verification" content="rem07kvz766qv6eo50nesnyp5tgkke" />
    <script is:inline define:vars={{ pixelId: "711175574443744" }}>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        (n.push = n), (n.loaded = !0), (n.version = "2.0"), (n.queue = []);
        t = b.createElement(e), (t.async = !0), (t.src = v);
        s = b.getElementsByTagName(e)[0], s.parentNode.insertBefore(t, s);
      })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
      fbq("init", pixelId);
      fbq("track", "PageView");
    </script>
    <!-- End Meta Pixel Code -->
  </head>
  <body>
    <!-- Meta Pixel noscript -->
    <noscript>
      <img
        height="1" width="1" style="display:none" alt=""
        src={`https://www.facebook.com/tr?id=711175574443744&ev=PageView&noscript=1`}
      />
    </noscript>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-primary focus:px-5 focus:py-2.5 focus:text-sm focus:font-bold focus:text-white"
    >
      Lompat ke konten
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBookingBar />
    <BookingGate />

    <script>
      // Reveal on scroll — vanilla, tanpa library (keputusan UX)
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // tinggi header (incl topbar) utk hero 100vh
      const setHeaderVar = () => {
        const h = document.getElementById("site-header");
        if (!h) return;
        const tb = h.previousElementSibling as HTMLElement | null;
        const total = h.offsetHeight + (tb && !tb.hidden ? tb.offsetHeight : 0);
        document.documentElement.style.setProperty("--site-header", total + "px");
      };
      setHeaderVar();
      addEventListener("resize", setHeaderVar);

      // fallback foto dokter/avatar: img gagal load → diganti lingkaran inisial
      document.addEventListener(
        "error",
        (e) => {
          const t = e.target as HTMLElement | null;
          if (t?.tagName !== "IMG" || !t.hasAttribute("data-fb")) return;
          const name = (t.getAttribute("alt") || "?").replace(/^drg\.?\s+/i, "");
          const ini =
            name
              .split(/\s+/)
              .slice(0, 2)
              .map((w) => w[0])
              .join("")
              .toUpperCase() || "?";
          const span = document.createElement("span");
          span.textContent = ini;
          span.className =
            t.className
              .replace(/border-\S+|object-cover/g, "")
              .trim() +
            " flex items-center justify-center bg-primary-soft font-heading font-extrabold text-primary";
          span.setAttribute("aria-label", name);
          t.replaceWith(span);
        },
        true,
      );
    </script>
  </body>
</html>
