---
/**
 * Halaman link-in-bio — URL /go-ig, /go-tt, /go-fb, /go-gmb (identik dgn WP lama,
 * agar tautan di bio sosmed tidak putus). Narasi & data sync dgn web utama (siteConfig).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import { CHANNELS, wa, IG, TIKTOK, SHOPEE, TOKOPEDIA, INSIDE_IG } from "../data/goChannels";
import { SITE } from "../data/siteConfig";

export function getStaticPaths() {
  return Object.entries(CHANNELS).map(([key, c]) => ({
    params: { go: `go-${key}` },
    props: { c },
  }));
}

const { c } = Astro.props;
const year = new Date().getFullYear();

const menu = [
  {
    label: "Lihat Promo Terbaru", sub: "Promo & diskon perawatan bulan ini", href: "/promo",
    full: '<svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82zM7 7h.01" /></svg>',
  },
  {
    label: "Pricelist Perawatan", sub: "Harga jelas & transparan",
    href: wa(`Saya mau PRICELIST perawatan B FRESH. Saya tahu dari ${c.waPricelist}`, c.utm),
    full: '<svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>',
  },
  {
    label: "Giveaway B Fresh", sub: "Ikut giveaway berhadiah",
    href: wa(`Saya mau GIVEAWAY B FRESH. Saya tahu dari ${c.waGiveaway}`, c.utm),
    full: '<svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="4" rx="1" /><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5" /></svg>',
  },
  {
    label: "Galeri Perawatan", sub: "Hasil perawatan asli pasien", href: "/galeri",
    full: '<svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" /></svg>',
  },
  {
    label: "Lokasi 15 Cabang", sub: "Sidoarjo, Gresik, Pasuruan, Surabaya & Malang", href: "/cabang",
    full: '<svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>',
  },
  {
    label: "Artikel & Edukasi", sub: "Tips kesehatan gigi & mulut", href: "/informasi",
    full: '<svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>',
  },
];

const chips = ["Dokter Ramah & Edukatif", "Harga Jelas & Transparan", `${SITE.since} · 15 Cabang · 5 Kota`];
---

<BaseLayout title={`B Fresh Dental Care di ${c.label}`} description={c.description}>
  <section class="bg-gradient-to-b from-primary-soft via-bg to-white py-12 md:py-16">
    <div class="mx-auto max-w-md px-4">
      <!-- Profil -->
      <div class="text-center">
        <img src="/favicon.png" alt="B Fresh Dental Care" width="101" height="101" class="mx-auto size-16 rounded-2xl border border-line bg-white object-contain shadow-card" />
        <h1 class="mt-4 font-heading text-2xl font-extrabold text-primary-deep">B Fresh Dental Care</h1>
        <p class="mt-1 text-sm text-ink-soft">{SITE.tagline}</p>
        <div class="mt-4 flex flex-wrap justify-center gap-2">
          {chips.map((chip) => (
            <span class="rounded-full border border-secondary/25 bg-white px-3 py-1 text-[11px] font-bold text-secondary-dark shadow-card">{chip}</span>
          ))}
        </div>
      </div>

      <!-- CTA utama -->
      <div class="mt-7 flex flex-col gap-5">
        <Button href={SITE.bookingUrl} target="_blank" rel="noopener" variant="accent" size="lg" class="w-full">
          <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
          Reservasi Online
        </Button>
        <Button href={wa(`Saya dapat informasi B Fresh dari ${c.waCs}`, c.utm)} target="_blank" rel="noopener" variant="outline" size="lg" class="w-full">
          <svg class="size-5 text-secondary" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.5 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.3.7-.2.3.1 1.6.8 1.9.9.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
          Hubungi WhatsApp CS
        </Button>
      </div>

      <!-- Menu -->
      <div class="mt-8 space-y-4">
        {
          menu.map((m) => (
            <a
              href={m.href}
              target={m.href.startsWith("http") ? "_blank" : undefined}
              rel={m.href.startsWith("http") ? "noopener" : undefined}
              class="group flex items-center gap-4 rounded-card border border-line bg-white px-5 py-5 shadow-card transition hover:-translate-y-0.5 hover:border-primary/30"
            >
              <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-primary-soft text-primary">{m.full && <Fragment set:html={m.full} />}</span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm leading-snug font-bold text-primary-deep group-hover:text-primary">{m.label}</span>
                <span class="mt-2 block truncate text-xs leading-snug text-ink-soft">{m.sub}</span>
              </span>
              <svg class="size-4 shrink-0 text-ink-soft/50 transition group-hover:translate-x-0.5 group-hover:text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          ))
        }
      </div>

      <!-- Sosial media -->
      <h2 class="mt-9 text-center font-heading text-base font-extrabold text-primary-deep">Ikuti Kami</h2>
      <div class="mt-4 flex justify-center gap-4">
        <a href={IG} target="_blank" rel="noopener" aria-label="Instagram B Fresh Dental Care" class="rounded-full bg-primary p-3.5 text-white shadow-card transition hover:bg-primary-dark">
          <svg class="size-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.9.1-3.2 0-3.6 0-4.8-.1-3.3-.1-4.8-1.7-4.9-4.9-.1-1.3-.1-1.6-.1-4.8s0-3.6.1-4.8C2.4 4 4 2.4 7.2 2.3c1.2-.1 1.6-.1 4.8-.1zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm5.2-9.4a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z"/></svg>
        </a>
        <a href={TIKTOK} target="_blank" rel="noopener" aria-label="TikTok B Fresh Dental Care" class="rounded-full bg-primary p-3.5 text-white shadow-card transition hover:bg-primary-dark">
          <svg class="size-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
        </a>
        <a href={SHOPEE} target="_blank" rel="noopener" aria-label="Shopee B Fresh Dental Care" class="rounded-full bg-primary p-3.5 text-white shadow-card transition hover:bg-primary-dark">
          <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 7V6a6 6 0 1 1 12 0v1h2.6l-1.4 14.1a2 2 0 0 1-2 1.9H6.8a2 2 0 0 1-2-1.9L3.4 7H6z"/><path d="M9 10.5c0 2 1.3 3.5 3 3.5s3-1.5 3-3.5"/></svg>
        </a>
        <a href={TOKOPEDIA} target="_blank" rel="noopener" aria-label="Tokopedia B Fresh Dental Care" class="rounded-full bg-primary p-3.5 text-white shadow-card transition hover:bg-primary-dark">
          <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9 5 3h14l2 6M3 9h18M3 9v11a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9M9 21v-6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v6"/></svg>
        </a>
      </div>

      <!-- Karir -->
      <div class="mt-8 rounded-card border border-line bg-white p-4 shadow-card">
        <h2 class="font-heading text-sm font-extrabold text-primary-deep">Karir di B Fresh</h2>
        <p class="mt-1 text-xs text-ink-soft">Lowongan dokter gigi, asisten & manajemen.</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <a href={SITE.careersUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-primary-soft px-3.5 py-1.5 text-xs font-bold text-primary transition hover:bg-primary hover:text-white">
            Daftar Lowongan Kerja
          </a>
          <a href="/karir" class="inline-flex items-center gap-1.5 rounded-full bg-primary-soft px-3.5 py-1.5 text-xs font-bold text-primary transition hover:bg-primary hover:text-white">
            Info Karir
          </a>
          <a href={INSIDE_IG} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-secondary-soft px-3.5 py-1.5 text-xs font-bold text-secondary-dark transition hover:bg-secondary hover:text-white">
            Inside B Fresh
          </a>
        </div>
      </div>

      <p class="mt-8 text-center text-xs text-ink-soft/70">© {year} {SITE.legalName} — {SITE.name}</p>
    </div>
  </section>
</BaseLayout>
