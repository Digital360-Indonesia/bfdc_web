---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { SITE } from "../../data/siteConfig";
import Icon from "../../components/ui/Icon.astro";

export async function getStaticPaths() {
  const doctors = await getCollection("doctors");
  return doctors.map((d) => ({ params: { slug: d.data.slug }, props: { doctor: d } }));
}

const { doctor } = Astro.props;
const { Content } = await render(doctor);
---
<BaseLayout title={doctor.data.name} description={`${doctor.data.name} — ${doctor.data.specialty} di ${doctor.data.branch}, B Fresh Dental Care.`}>
  <article class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <nav class="mb-6 text-xs font-semibold text-ink-soft" aria-label="Breadcrumb">
      <a href="/dokter" class="hover:text-primary">Dokter</a>
      <span class="mx-1.5">/</span>
      <span>{doctor.data.name}</span>
    </nav>

    <div class="reveal flex flex-col items-start gap-6 sm:flex-row sm:items-center">
      <img
        src={doctor.data.photo === "/images/doctors/placeholder.webp" ? "/images/logos/logo.png" : doctor.data.photo}
        alt={doctor.data.name}
        width="160" height="160" loading="eager" decoding="async"
        class="size-36 shrink-0 rounded-3xl border-4 border-primary-soft object-cover"
      />
      <div>
        <h1 class="font-heading text-3xl font-extrabold text-primary-deep md:text-4xl">{doctor.data.name}</h1>
        <p class="mt-1.5 text-sm font-bold tracking-wide text-secondary uppercase">{doctor.data.specialty}</p>
        <p class="mt-1 inline-flex items-center gap-1 text-sm text-ink-soft"><Icon name="map-pin" class="size-4 text-primary/60" /> {doctor.data.branch}</p>
        {doctor.data.passions.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {doctor.data.passions.map((p) => (
              <span class="rounded-full bg-primary-soft px-3 py-1 text-xs font-semibold text-primary">{p}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="prose mt-10">
      <Content />
    </div>

    <div class="mt-10 flex flex-col gap-3 rounded-card bg-primary-deep p-6 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <p class="text-sm font-semibold text-white">
        Ingin periksa dengan {doctor.data.name.replace(/^drg\.?\s*/i, "drg. ")}?
      </p>
      <a href={SITE.bookingUrl} target="_blank" rel="noopener" class="shrink-0 rounded-full bg-accent px-6 py-3 text-sm font-bold text-white transition hover:bg-accent-dark">
        Reservasi Sekarang
      </a>
    </div>
  </article>
</BaseLayout>
