---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { KATEGORI } from "../../data/services";
import { SITE } from "../../data/siteConfig";
import Icon from "../../components/ui/Icon.astro";

const services = await getCollection("services");
const KAT_ICON: Record<string, string> = Object.fromEntries(KATEGORI.map((k) => [k.slug, k.icon]));
---
<BaseLayout
  title="Daftar Harga Perawatan Gigi"
  description="Daftar harga perawatan B Fresh Dental Care: scaling mulai Rp 150rb, tambal gigi, behel, gigi tiruan, bleaching — transparan & sesuai kondisi klinis."
>
  <section class="bg-gradient-to-b from-primary-soft to-white py-14 md:py-18">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <span class="mb-3 inline-block rounded-full bg-white px-4 py-1 text-xs font-bold tracking-widest text-primary uppercase shadow-card">Transparan Sejak Awal</span>
      <h1 class="text-balance font-heading text-4xl font-extrabold text-primary-deep md:text-5xl">Daftar Harga</h1>
      <p class="mt-4 text-ink-soft md:text-lg">Harga di bawah adalah estimasi mulai-dari — biaya final selalu dikonfirmasi dokter setelah pemeriksaan, sebelum perawatan dimulai.</p>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="mx-auto max-w-4xl space-y-10 px-4">
      {
        KATEGORI.map((k) => {
          const list = services.filter((s) => s.data.kategori === k.slug).sort((a, b) => a.data.order - b.data.order);
          if (!list.length) return null;
          return (
            <div class="reveal">
              <div class="flex items-center gap-3">
                <span class="flex size-10 items-center justify-center rounded-xl bg-primary-soft text-primary"><Icon name={KAT_ICON[k.slug]} class="size-5" /></span>
                <h2 class="font-heading text-xl font-extrabold text-primary-deep">{k.label}</h2>
                <a href={`/layanan#${k.slug}`} class="ml-auto text-xs font-bold text-accent hover:underline">Info layanan →</a>
              </div>
              <div class="mt-4 overflow-hidden rounded-card border border-line shadow-card">
                <table class="w-full text-left">
                  <tbody class="divide-y divide-line">
                    {list.flatMap((s) =>
                      s.data.pricing.map((p, i) => (
                        <tr class="bg-white transition hover:bg-bg">
                          {i === 0 && <td rowspan={s.data.pricing.length} class="w-1/3 border-r border-line px-5 py-4 align-top">
                            <a href={`/layanan/${s.data.slug}`} class="text-sm font-bold text-primary-deep hover:text-primary">{s.data.title}</a>
                          </td>}
                          <td class="px-5 py-3.5 text-sm text-ink-soft">
                            {p.name}
                            {p.desc && <span class="block text-xs text-ink-soft/70">{p.desc}</span>}
                          </td>
                          <td class="w-40 px-5 py-3.5 text-right font-heading text-sm font-extrabold whitespace-nowrap text-primary">
                            {p.original && <s class="mr-1.5 block text-xs font-medium text-ink-soft/60">{p.original}</s>}
                            {p.price}
                          </td>
                        </tr>
                      )),
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          );
        })
      }

      <div class="reveal rounded-card border border-secondary/25 bg-secondary-soft p-6 text-sm leading-relaxed text-ink-soft">
        <p><strong class="text-secondary-dark">Catatan:</strong> Biaya perawatan ditentukan oleh kondisi klinis masing-masing pasien (tingkat keparahan, bahan yang digunakan, jumlah kunjungan). Angka di atas adalah titik awal yang wajar — bukan harga final. Anda selalu berhak menanyakan estimasi biaya <em>sebelum</em> perawatan dimulai.</p>
        <p class="mt-3">Cek <a href="/promo" class="font-semibold text-primary hover:underline">promo berjalan</a> untuk harga spesial bulan ini.</p>
      </div>
    </div>
  </section>
</BaseLayout>
