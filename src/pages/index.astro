---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import TrustBar from "../components/sections/TrustBar.astro";
import BranchLocator from "../components/sections/BranchLocator.astro";
import ServiceGrid from "../components/sections/ServiceGrid.astro";
import PromoCardsStrip from "../components/sections/PromoCardsStrip.astro";
import WhyUs from "../components/sections/WhyUs.astro";
import DoctorsGrid from "../components/sections/DoctorsGrid.astro";
import DentalQuiz from "../components/sections/DentalQuiz.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import GalleryTabs from "../components/sections/GalleryTabs.astro";
import BlogPreview from "../components/sections/BlogPreview.astro";
import ClosingCTA from "../components/sections/ClosingCTA.astro";
---

<BaseLayout>
  <div class="flex min-h-[calc(100svh-var(--site-header,5.5rem))] flex-col">
    <Hero />
    <PromoCardsStrip />
  </div>
  <TrustBar />
  <BranchLocator />
  <ServiceGrid />
  <WhyUs />
  <DoctorsGrid />
  <DentalQuiz />
  <Testimonials />
  <GalleryTabs />
  <BlogPreview />
  <ClosingCTA />
</BaseLayout>
