---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import BlogGrid from "../../components/sections/BlogGrid.astro";
import LoadMore from "../../components/sections/LoadMore.astro";

export const CATEGORIES = ["edukasi", "informasi", "promo", "kegiatan-sosial"] as const;

const all = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date);

const PER_PAGE = 12;
const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
const posts = all.slice(0, PER_PAGE);

const CAT_LABEL: Record<string, string> = {
  edukasi: "Edukasi",
  informasi: "Informasi",
  promo: "Promo",
  "kegiatan-sosial": "Kegiatan Sosial",
};
const activeCat = "semua";
---
<BaseLayout
  title="Edukasi Kesehatan Gigi"
  description="Artikel edukasi kesehatan gigi & mulut dari tim medis B Fresh Dental Care — tips merawat gigi, jawaban dokter, dan panduan perawatan."
>
  <section class="bg-gradient-to-b from-primary-soft to-white py-14 md:py-18">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <span class="mb-3 inline-block rounded-full bg-white px-4 py-1 text-xs font-bold tracking-widest text-primary uppercase shadow-card">Edukasi</span>
      <h1 class="text-balance font-heading text-4xl font-extrabold text-primary-deep md:text-5xl">Belajar Merawat Senyum</h1>
      <p class="mt-4 text-ink-soft md:text-lg">{all.length} artikel ditinjau tim medis kami — dari tips harian hingga panduan perawatan.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        <a href="/informasi" class="rounded-full bg-primary px-4 py-2 text-sm font-bold text-white shadow-sm">Semua</a>
        {CATEGORIES.map((k) => (
          <a href={k === "promo" ? "/promo" : `/informasi/kategori/${k}`} class="rounded-full border border-line bg-white px-4 py-2 text-sm font-bold text-ink-soft transition hover:border-primary/40 hover:text-primary">{CAT_LABEL[k]}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4">
      <BlogGrid posts={posts} />

      <LoadMore nextUrl={totalPages > 1 ? "/informasi/page/2" : null} total={all.length} />
</div>
  </section>
</BaseLayout>
