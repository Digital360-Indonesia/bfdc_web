---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import BlogGrid from "../../../../components/sections/BlogGrid.astro";
import LoadMore from "../../../../components/sections/LoadMore.astro";

const PER_PAGE = 12;
const CAT_LABEL: Record<string, string> = {
  edukasi: "Edukasi",
  informasi: "Informasi",
  promo: "Promo",
  "kegiatan-sosial": "Kegiatan Sosial",
};

export async function getStaticPaths() {
  const PER_PAGE = 12;
  const all = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => +b.data.date - +b.data.date);
  const cats = [...new Set(all.map((p) => p.data.category))];
  return cats.map((kat) => ({
    params: { kat },
    props: {
      posts: all.filter((p) => p.data.category === kat).slice(0, PER_PAGE),
      total: all.filter((p) => p.data.category === kat).length,
    },
  }));
}

const { kat } = Astro.params;
const { posts, total } = Astro.props;
const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
---
<BaseLayout
  title={`Edukasi ${CAT_LABEL[kat] ?? kat}`}
  description={`Kumpulan artikel kategori ${CAT_LABEL[kat] ?? kat} — B Fresh Dental Care.`}
>
  <section class="bg-gradient-to-b from-primary-soft to-white py-12 md:py-14">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <nav class="mb-3 text-xs font-semibold text-ink-soft" aria-label="Breadcrumb">
        <a href="/informasi" class="hover:text-primary">Edukasi</a>
        <span class="mx-1.5">/</span>
        <span>{CAT_LABEL[kat] ?? kat}</span>
      </nav>
      <h1 class="font-heading text-3xl font-extrabold text-primary-deep md:text-4xl">{CAT_LABEL[kat] ?? kat}</h1>
      <p class="mt-3 text-sm text-ink-soft md:text-base">{total} artikel dalam kategori ini.</p>
      <div class="mt-5 flex flex-wrap justify-center gap-2">
        <a href="/informasi" class="rounded-full bg-primary px-4 py-2 text-sm font-bold text-white shadow-sm">Semua</a>
        {Object.entries(CAT_LABEL).map(([k, label]) => (
          <a href={k === "promo" ? "/promo" : `/informasi/kategori/${k}`} class={`rounded-full px-4 py-2 text-sm font-bold transition ${k === kat ? "border border-primary/40 bg-primary-soft text-primary" : "border border-line bg-white text-ink-soft hover:border-primary/40 hover:text-primary"}`}>{label}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-7xl px-4">
      <BlogGrid posts={posts} />

      <LoadMore nextUrl={totalPages > 1 ? `/informasi/kategori/${kat}/page/2` : null} total={total} />
</div>
  </section>
</BaseLayout>
