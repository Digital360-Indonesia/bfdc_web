---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import BlogGrid from "../../../../../components/sections/BlogGrid.astro";

const PER_PAGE = 12;
const CAT_LABEL: Record<string, string> = {
  edukasi: "Edukasi",
  informasi: "Informasi",
  promo: "Promo",
  "kegiatan-sosial": "Kegiatan Sosial",
};

export async function getStaticPaths({ paginate }) {
  const PER_PAGE = 12;
  const all = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => +b.data.date - +b.data.date);
  const cats = [...new Set(all.map((p) => p.data.category))];
  const routes = cats.flatMap((kat) =>
    paginate(all.filter((p) => p.data.category === kat), {
      pageSize: PER_PAGE,
      params: { kat },
    }),
  );
  // halaman 1 kategori dilayani /informasi/kategori/[kat]
  return routes.filter((r) => Number(r.params.page) > 1);
}

const { kat } = Astro.params;
const { page } = Astro.props;
const now = page.currentPage;
const totalPages = page.lastPage;
const window = Array.from({ length: totalPages }, (_, i) => i + 1).slice(
  Math.max(0, Math.min(now - 3, totalPages - 5)),
  Math.max(5, Math.min(now + 2, totalPages)),
);
const q = (n: number) => (n === 1 ? `/informasi/kategori/${kat}` : `/informasi/kategori/${kat}/page/${n}`);
---
<BaseLayout
  title={`${CAT_LABEL[kat] ?? kat} — Halaman ${now}`}
  description={`Kumpulan artikel kategori ${CAT_LABEL[kat] ?? kat} — B Fresh Dental Care.`}
  noindex
>
  <section class="bg-gradient-to-b from-primary-soft to-white py-12">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <nav class="mb-3 text-xs font-semibold text-ink-soft" aria-label="Breadcrumb">
        <a href="/informasi" class="hover:text-primary">Edukasi</a>
        <span class="mx-1.5">/</span>
        <a href={`/informasi/kategori/${kat}`} class="hover:text-primary">{CAT_LABEL[kat] ?? kat}</a>
      </nav>
      <h1 class="font-heading text-3xl font-extrabold text-primary-deep md:text-4xl">{CAT_LABEL[kat] ?? kat}</h1>
      <p class="mt-3 text-sm text-ink-soft">Halaman {now} dari {totalPages} — {page.total} artikel.</p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-7xl px-4">
      <BlogGrid posts={page.data} />

      <nav class="mt-10 flex flex-wrap items-center justify-center gap-2" aria-label="Navigasi halaman">
        {page.url.prev && (
          <a href={page.url.prev} class="rounded-full border border-line bg-white px-4 py-2 text-sm font-bold text-primary transition hover:border-primary">← Sebelumnya</a>
        )}
        {window.map((n) => (
          <a href={q(n)} class={`min-w-10 rounded-full px-4 py-2 text-center text-sm font-bold transition ${n === now ? "bg-primary text-white" : "border border-line bg-white text-ink-soft hover:border-primary/40 hover:text-primary"}`}>{n}</a>
        ))}
        {page.url.next && (
          <a href={page.url.next} class="rounded-full border border-line bg-white px-4 py-2 text-sm font-bold text-primary transition hover:border-primary">Selanjutnya →</a>
        )}
      </nav>
    </div>
  </section>
</BaseLayout>
