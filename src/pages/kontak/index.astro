---
import BaseLayout from "../../layouts/BaseLayout.astro";
import faqs from "../../data/faqs.json";
import branches from "../../data/branches.json";
import { SITE, waLink } from "../../data/siteConfig";
import { jsonLdFaq } from "../../utils/schema";

// kurasi FAQ general (hindari duplikat & yang spesifik-temporer)
const curated = (faqs as { q: string; a: string }[])
  .filter((f) => !/instagram/i.test(f.q) || /lokasi/i.test(f.q))
  .filter((f, i, arr) => arr.findIndex((x) => x.q.slice(0, 25) === f.q.slice(0, 25)) === i)
  .slice(0, 10);
---
<BaseLayout
  title="Kontak & FAQ"
  description={`Hubungi B Fresh Dental Care: CS ${SITE.phone}, email ${SITE.email}, reservasi online, atau kunjungi ${branches.length} cabang kami. Jawaban pertanyaan yang sering diajukan.`}
  jsonLd={jsonLdFaq(curated.map((f) => ({ question: f.q, answer: f.a })))}
>
  <section class="bg-gradient-to-b from-primary-soft to-white py-14 md:py-18">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <span class="mb-3 inline-block rounded-full bg-white px-4 py-1 text-xs font-bold tracking-widest text-primary uppercase shadow-card">Kontak</span>
      <h1 class="text-balance font-heading text-4xl font-extrabold text-primary-deep md:text-5xl">Kami Siap Membantu</h1>
      <p class="mt-4 text-ink-soft md:text-lg">Ada pertanyaan sebelum reservasi? Tim CS kami siap menjawab — biasanya dalam hitungan menit.</p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto grid max-w-4xl gap-5 px-4 sm:grid-cols-3">
      <a href={waLink()} target="_blank" rel="noopener" class="reveal group rounded-card border border-line bg-bg p-6 text-center shadow-card transition hover:-translate-y-1 hover:shadow-card-hover">
        <span class="mx-auto mb-3 flex size-14 items-center justify-center rounded-2xl bg-secondary-soft text-secondary">
          <svg class="size-7" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.5 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.3.7-.2.3.1 1.6.8 1.9.9.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
        </span>
        <h2 class="font-heading text-base font-bold text-primary-deep">WhatsApp CS</h2>
        <p class="mt-1 text-sm font-semibold text-secondary">{SITE.phone}</p>
        <p class="mt-1 text-xs text-ink-soft">Reservasi & tanya-tanya</p>
      </a>
      <a href={`tel:${SITE.phone.replace(/-/g, "")}`} class="reveal group rounded-card border border-line bg-bg p-6 text-center shadow-card transition hover:-translate-y-1 hover:shadow-card-hover">
        <span class="mx-auto mb-3 flex size-14 items-center justify-center rounded-2xl bg-primary-soft text-primary">
          <svg class="size-7" fill="currentColor" viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
        </span>
        <h2 class="font-heading text-base font-bold text-primary-deep">Telepon</h2>
        <p class="mt-1 text-sm font-semibold text-primary">{SITE.phone}</p>
        <p class="mt-1 text-xs text-ink-soft">{SITE.hours}</p>
      </a>
      <a href={`mailto:${SITE.email}`} class="reveal group rounded-card border border-line bg-bg p-6 text-center shadow-card transition hover:-translate-y-1 hover:shadow-card-hover">
        <span class="mx-auto mb-3 flex size-14 items-center justify-center rounded-2xl bg-accent-soft text-accent">
          <svg class="size-7" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
        </span>
        <h2 class="font-heading text-base font-bold text-primary-deep">Email</h2>
        <p class="mt-1 truncate text-sm font-semibold text-accent">{SITE.email}</p>
        <p class="mt-1 text-xs text-ink-soft">Kerjasama & kemitraan</p>
      </a>
    </div>
  </section>

  <section class="bg-bg py-12 md:py-16">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="text-center font-heading text-2xl font-extrabold text-primary-deep md:text-3xl">Pertanyaan yang Sering Diajukan</h2>
      <p class="mt-2 text-center text-sm text-ink-soft">Dari percakapan asli pasien kami di Instagram & WhatsApp</p>
      <div class="reveal mt-8 space-y-3">
        {
          curated.map((f) => (
            <details class="group rounded-2xl border border-line bg-white px-5 py-4 open:border-primary/30">
              <summary class="cursor-pointer list-none text-sm font-bold text-primary-deep marker:hidden">
                <span class="flex items-center justify-between gap-3">{f.q}<svg class="size-4 shrink-0 text-primary transition group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed whitespace-pre-line text-ink-soft">{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-8 text-center text-sm text-ink-soft">
        Tidak menemukan jawaban?
        <a href={waLink()} target="_blank" rel="noopener" class="font-bold text-primary hover:underline">Tanya langsung via WhatsApp →</a>
      </p>
    </div>
  </section>
</BaseLayout>
