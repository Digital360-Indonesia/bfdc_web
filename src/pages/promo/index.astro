---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PromoLive from "../../components/sections/PromoLive.astro";
import { SITE } from "../../data/siteConfig";
---

<BaseLayout
  title="Promo Terbaru"
  description="Promo perawatan gigi terbaru B Fresh Dental Care — scaling, tambal gigi, behel, gigi palsu & lainnya. Berlaku di 15 cabang."
>
  <section class="bg-gradient-to-b from-primary-soft to-white py-14 md:py-18">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <span class="mb-3 inline-block rounded-full bg-white px-4 py-1 text-xs font-bold tracking-widest text-primary uppercase shadow-card">Promo Berjalan</span>
      <h1 class="text-balance font-heading text-4xl font-extrabold text-primary-deep md:text-5xl">Senyum Sehat, Harga Bersahabat</h1>
      <p class="mt-4 text-ink-soft md:text-lg">Promo diperbarui berkala — ikuti Instagram kami untuk info terbaru.</p>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4">
      <PromoLive />

      <div class="reveal mt-12 rounded-card border border-secondary/25 bg-secondary-soft p-6 text-sm leading-relaxed text-ink-soft md:p-8">
        <h2 class="font-heading text-base font-extrabold text-secondary-dark">Syarat &amp; Ketentuan Umum Promo</h2>
        <ul class="mt-3 list-inside list-disc space-y-1.5">
          <li>Berlaku di semua cabang B Fresh Dental Care kecuali disebutkan lain.</li>
          <li>Reservasi melalui CS <a href={`tel:${SITE.phone.replace(/-/g, "")}`} class="font-semibold text-primary hover:underline">{SITE.phone}</a> atau reservasi online.</li>
          <li>Gratis konsultasi dokter gigi untuk peserta promo.</li>
          <li>Promo terbatas — dapat berakhir jika kuota penuh.</li>
          <li>WAJIB konfirmasi kedatangan sebelum ke klinik.</li>
          <li>Tidak dapat digabung dengan promo lain kecuali disetujui klinik.</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
